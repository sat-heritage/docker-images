    "hcad-psbva": {
        "status": "ok",
        "name": "hCaD-psbva",
        "version": "1.9.5",
        "authors": "Rodrigue Konan Tchinda, Clémentin Tayou Djamegni",
        "call": "python3",
        "gz": false,
        "args": [
            "wrapper.py",
            "--input",
            "FILECNF",
            "--output",
            "PROOFDIR",
            "--bva",
            "./bva",
            "--t1",
            "200",
            "--t2",
            "400",
            "--solver",
            "./cadical",
            "--solverargs",
            "psids=1",
            "target=2",
            "walk=false",
            "chrono=true"
        ],
        "argsproof": [
            "wrapper.py",
            "--input",
            "FILECNF",
            "--output",
            "PROOFDIR",
            "--bva",
            "./bva",
            "--t1",
            "200",
            "--t2",
            "400",
            "--solver",
            "./cadical",
            "--solverargs",
            "psids=1",
            "target=2",
            "walk=false",
            "chrono=true"
        ],
        "tracks": [
            "main"
        ],
        "comment": "Structured BVA preprocessing (bva) followed by the solver, driven by the submitted wrapper.py; the proof concatenates the BVA derivation and the solver's DRAT proof.",
        "license": "BSD-2-Clause AND BSD-3-Clause AND GPL-2.0 AND GPL-3.0 AND LGPL-2.1 AND MIT",
        "license_source": "licence file hCaD-psbva/archives/eigen-3.4.0/COPYING.MINPACK, hCaD-psbva/archives/eigen-3.4.0/COPYING.BSD, hCaD-psbva/archives/eigen-3.4.0/bench/btl/COPYING, hCaD-psbva/archives/eigen-3.4.0/COPYING.GPL, hCaD-psbva/archives/eigen-3.4.0/COPYING.LGPL, hCaD-psbva/LICENSE"
